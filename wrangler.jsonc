{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teraland",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "STATE", "class_name": "ProviderState" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProviderState"] }],
  "vars": {
    "ISSUER": "https://teraland.YOUR-SUBDOMAIN.workers.dev",
    "FEDERATION_HOSTS": "[]",
    "TRUST_ANCHORS": "{}",
  },
}
