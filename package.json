{
  "name": "teraland",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "setup:local": "node scripts/setup-local.mjs",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .build",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "wrangler deploy",
    "format": "prettier --write src test scripts *.json *.jsonc README.md .github/workflows",
    "format:check": "prettier --check src test scripts *.json *.jsonc README.md .github/workflows"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.5",
    "miniflare": "^5.20261019.2-beta",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
